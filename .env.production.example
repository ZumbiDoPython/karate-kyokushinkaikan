# Copie para .env.production antes do build (não commite senhas reais em repo público)

REACT_APP_USE_CONTENT_API=true

# Produção com CMS na nuvem (recomendado)
REACT_APP_CONTENT_USE_FIRESTORE=true
REACT_APP_CONTENT_USE_LOCAL_STORE=false

# Cole os valores do Firebase Console → Configurações do projeto → Seus apps (Web)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Opcional — galeria (plano gratuito Supabase)
# REACT_APP_SUPABASE_URL=
# REACT_APP_SUPABASE_ANON_KEY=

GENERATE_SOURCEMAP=false
